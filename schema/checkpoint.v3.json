{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "belay/checkpoint.v3",
  "title": "A checkpoint, as `belay check --json`, `belay mark --json` and `belay log --json` print it",
  "description": "A checkpoint made before checkpoint.v3 stays as stored: `belay log --json` prints it as the checkpoint.v2 record it printed before, without `unreadable`, `sealing`, `basis`, `carried`, `runtime_sha256`, `journal_seq` and `shadow_lines_sha256` (not recorded is not zero), and this schema does not describe that line.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "created_ns",
    "entries",
    "raced",
    "unstable",
    "vanished",
    "unreadable",
    "sealing",
    "provisional",
    "excluded",
    "excluded_paths",
    "prefilter",
    "basis",
    "carried",
    "source",
    "stored",
    "kept",
    "runtime_sha256",
    "journal_seq",
    "shadow_lines_sha256"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "check",
        "mark",
        "diff"
      ]
    },
    "created_ns": {
      "type": "integer"
    },
    "scope": {
      "type": "string"
    },
    "scope_b64": {
      "type": "string",
      "description": "the scope's path in base64, when it is not UTF-8"
    },
    "manifest": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest_b64": {
      "type": "string",
      "description": "the manifest's path in base64, when it is not UTF-8"
    },
    "entries": {
      "type": "integer",
      "minimum": 1
    },
    "raced": {
      "type": "integer",
      "minimum": 0
    },
    "unstable": {
      "type": "integer",
      "minimum": 0
    },
    "vanished": {
      "type": "integer",
      "minimum": 0
    },
    "unreadable": {
      "type": "integer",
      "minimum": 0,
      "description": "the manifest trailer's `unreadable`: entries whose content or listing could not be read"
    },
    "sealing": {
      "type": "integer",
      "minimum": 0,
      "description": "directories nothing below which was looked at: those carrying `unreadable` or `mount`"
    },
    "provisional": {
      "type": "boolean"
    },
    "excluded": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_paths": {
      "type": "array",
      "description": "every path the capture did not walk, from the manifest's header (manifest v2 `excluded`)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "path_b64": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "state_dir",
              "user"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "path_b64"
            ]
          }
        ]
      }
    },
    "prefilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "reference",
        "trusted",
        "racy",
        "full_reason"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "reference": {
          "enum": [
            "none",
            "walk_start",
            "newest_ctime"
          ],
          "description": "what a file's ctime was compared with: the previous walk's start, or (belay's state on another filesystem) the newest ctime it recorded; none when every file was read"
        },
        "trusted": {
          "type": "integer",
          "minimum": 0
        },
        "racy": {
          "type": "integer",
          "minimum": 0
        },
        "full_reason": {
          "type": "string"
        }
      }
    },
    "basis": {
      "enum": [
        "walk",
        "events"
      ],
      "description": "how the capture knew what to read; always `walk` in this release"
    },
    "carried": {
      "type": "integer",
      "minimum": 0,
      "description": "entries taken from the previous manifest without a stat; 0 for a walk"
    },
    "source": {
      "description": "the manifest's source (manifest v3): null for a scope walked where belay ran, or the container a host-reader capture read",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docker",
            "image"
          ],
          "properties": {
            "docker": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "image": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "stored": {
      "type": "string",
      "enum": [
        "whole",
        "delta"
      ]
    },
    "kept": {
      "type": "boolean"
    },
    "runtime_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "the sha256 of the checkpoint's runtime record, or null when it has none; always null in this release"
    },
    "journal_seq": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "description": "the kernel record's journal sequence number of this checkpoint's barrier, or null when it was not taken under a kernel record; always null in this release"
    },
    "shadow_lines_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "the sha256 of the checkpoint's per-line digest file for shadow/gshadow, or null when it has none: a system watch's checkpoint has one when shadow or gshadow was read sealed (system-interpreters.md SA-6)"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "scope"
          ]
        },
        {
          "required": [
            "scope_b64"
          ]
        }
      ]
    },
    {
      "oneOf": [
        {
          "required": [
            "manifest"
          ]
        },
        {
          "required": [
            "manifest_b64"
          ]
        }
      ]
    }
  ]
}
