#!/bin/sh
#
# belay-dogfood EVENT -- the M1.5 Claude Code hook (NOTES design: m1.5-structure;
# decision-log rows 86-88). Installed outside the repository and run from the
# user's settings, with the pinned release binary: nothing done in the working
# tree changes the reviewer.
#
#   start   SessionStart              the session's base checkpoint
#   pre     PreToolUse   (writing)    a checkpoint before the call
#   post    PostToolUse(Failure)      a checkpoint after it
#   stop    Stop                      a checkpoint; the turn's receipt; one line
#                                     when something changed in the turn
#   end     SessionEnd                a last checkpoint; the session's receipt,
#                                     copied to NOTES/dogfood/ when interesting
#
# Reads the hook's JSON on stdin. Never fails a tool call: always exits 0.
# Never silent either (decision 114): whatever goes wrong in any hook is
# kept in <state>/dogfood/failing, and the next Stop says it in one line,
# every Stop while it keeps going wrong. (A checksum that no longer matches
# is said by the settings command itself: install.sh.) Environment:
#   BELAY                the binary (default ~/.local/bin/belay)
#   BELAY_DOGFOOD_SCOPE  the repository to watch; other projects are ignored
#   BELAY_STATE_DIR      belay's state directory (default as belay's)
#   BELAY_DOGFOOD_NOTES  where interesting receipts are copied (default
#                        $BELAY_DOGFOOD_SCOPE/NOTES/dogfood)
#   BELAY_DOGFOOD_TASKS  where Claude Code writes background commands' output
#                        (default ${TMPDIR:-/tmp}/claude-<uid>/*/<session>/tasks)

set -u
t0=$(date +%s%N)
ev=${1:-}
BELAY=${BELAY:-$HOME/.local/bin/belay}
SCOPE=${BELAY_DOGFOOD_SCOPE:-}
STATE=${BELAY_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/belay}
HERE=$(dirname "$0")
in=$(cat)

[ -n "$SCOPE" ] && [ "${CLAUDE_PROJECT_DIR:-}" = "$SCOPE" ] || exit 0     # this repository only (Q5)
case $ev in start|pre|post|stop|end) ;; *) exit 0 ;; esac

D=$STATE/dogfood
FAILING=$D/failing
here=
# A failure, kept for the next Stop; where even that cannot be written, this
# invocation says it itself when it is a Stop.
fail() {
    { mkdir -p "$D" && chmod 700 "$D" && printf '%s: %s\n' "$ev" "$1" | tr -d '\000-\011\013-\037' >> "$FAILING"; } \
        2>/dev/null || here="$ev: $1"
}
# JSON's string escapes, for a line made here.
js() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'; }
# Stop's message: the hooks' failures since the last Stop first, then the
# turn's line (`$1`, from receipt.py); nothing when there is neither.
say() {
    f=
    if [ -s "$FAILING" ] && mv "$FAILING" "$FAILING.$$" 2>/dev/null; then
        n=$(wc -l < "$FAILING.$$")
        f=$(head -1 "$FAILING.$$")
        [ "$n" -gt 1 ] && f="$f (and $((n - 1)) more since the last stop: $D/failures.log)"
        cat "$FAILING.$$" >> "$D/failures.log" 2>/dev/null
        rm -f "$FAILING.$$"
    fi
    [ -n "$here" ] && f="$here${f:+; $f}"
    [ -n "$f" ] && f="belay: hooks failing: $f"
    if [ -n "$f" ] && [ -n "$1" ]; then m="$(js "$f")\n$(js "$1")"; else m=$(js "$f$1"); fi
    [ -z "$m" ] || printf '{"systemMessage":"%s"}\n' "$m"
}
quit() { [ "$ev" = stop ] && say ""; exit 0; }
command -v jq >/dev/null 2>&1 || { fail "jq not found"; quit; }

# One jq for the whole input (each process costs; a writing tool call runs
# two hooks): the session, the call, and what the receipt calls it -- a
# command's first line, a file, a tool's name -- already JSON-encoded; and
# the whole command, for the receipt's detail (turn-267: a label cut at 200
# characters hid the `git fetch` that wrote what it was blamed for).
eval "$(printf '%s' "$in" | jq -r '((.tool_input.command // .tool_input.file_path // .tool_input.notebook_path // .tool_input.description // "") | tostring) as $c | @sh "sid=\(.session_id // "") tid=\(.tool_use_id // "") tool=\(.tool_name // "") agent=\(.agent_type // "") bgtask=\(.tool_response.backgroundTaskId // (if .tool_input.run_in_background == true then "?" else "" end)) summary=\($c | split("\n")[0] | .[0:200] | @json) full=\($c | .[0:65536])"' 2>/dev/null)" || { fail "the hook's input could not be read"; quit; }
case ${sid:-} in ''|*[!A-Za-z0-9_-]*) fail "the hook's input names no session"; quit ;; esac   # a name, never a path

mkdir -p "$D" 2>/dev/null && chmod 700 "$D" 2>/dev/null || { fail "cannot create $D"; quit; }
LOG=$D/$sid.jsonl

# One line, one write, appended: concurrent hooks never interleave (each line
# is far under PIPE_BUF). The checkpoint id orders events, not the log.
log() { printf '%s\n' "$1" >> "$LOG" 2>/dev/null || fail "cannot write $LOG"; }

# The whole command, once per call, in a file of its own: the log's lines
# stay short (one write each), and only the call's own pre hook writes it.
if [ "$ev" = pre ] && [ -n "${tid:-}" ]; then
    f=$(printf '%s' "$tid" | tr -cd 'A-Za-z0-9_-')
    [ -n "$f" ] && mkdir -p "$D/$sid.calls" 2>/dev/null && printf '%s' "$full" > "$D/$sid.calls/$f" 2>/dev/null
fi

# A mark's checkpoint id, from `{"id":N,...}` without another process; ""
# on failure, logged with belay's message.
cp=
if out=$("$BELAY" mark --scope "$SCOPE" --json 2>"$D/$sid.mark-err.$$"); then
    cp=${out#\{\"id\":}
    cp=${cp%%,*}
    case $cp in ''|*[!0-9]*) cp= ;; esac
fi
if [ -z "$cp" ]; then
    msg=$(head -c 300 "$D/$sid.mark-err.$$" 2>/dev/null | tr -d '\000-\037"\\')
    log "{\"event\":\"error\",\"during\":\"$ev\",\"message\":\"$msg\"}"
    fail "belay mark failed: ${msg:-no checkpoint id}"
fi
rm -f "$D/$sid.mark-err.$$"
t1=$(date +%s%N)
# Names from Claude Code are [A-Za-z0-9_] in practice; anything else is
# dropped rather than escaped by hand. The summary arrives JSON-encoded.
clean() { printf '%s' "$1" | tr -cd 'A-Za-z0-9_.:-'; }
bg=
[ "$ev" = post ] && [ -n "${bgtask:-}" ] && bg=",\"background\":\"$(clean "$bgtask")\""
log "{\"event\":\"$ev\",\"cp\":${cp:-null},\"tool_use_id\":\"$(clean "$tid")\",\"tool\":\"$(clean "$tool")\",\"agent\":\"$(clean "$agent")\",\"summary\":${summary:-\"\"}$bg,\"t0\":$t0,\"t1\":$t1}"

# A command still running in the background after its post (asked to, or
# moved there at its timeout) may write at any checkpoint until it ends
# (decision 111). Its end is seen here, at the first hook after it: the
# command's output file is no longer open in any process. Where that file
# cannot be found, the next stop ends it -- so "may have written" never
# outlives the turn unseen.
B=$D/$sid.background
if [ -n "$bg" ] && [ -n "${tid:-}" ]; then
    f=$(printf '%s' "$tid" | tr -cd 'A-Za-z0-9_-'); task=$(clean "$bgtask"); out=
    for t in ${BELAY_DOGFOOD_TASKS:-"${TMPDIR:-/tmp}"/claude-$(id -u)/*/"$sid"/tasks}; do
        [ -e "$t/$task.output" ] && out=$t/$task.output && break
    done
    [ -n "$f" ] && mkdir -p "$B" 2>/dev/null && printf '%s' "$out" > "$B/$f"
elif [ -d "$B" ] && [ -n "$cp" ]; then
    for m in "$B"/*; do
        [ -f "$m" ] || continue
        out=$(cat "$m" 2>/dev/null)
        if [ -n "$out" ] && [ -d /proc/self/fd ]; then
            find /proc/[0-9]*/fd -lname "$out" -print -quit 2>/dev/null | grep -q . && continue
        elif [ "$ev" != stop ] && [ "$ev" != end ]; then
            continue
        fi
        rm -f "$m" && log "{\"event\":\"background_end\",\"cp\":$cp,\"tool_use_id\":\"${m##*/}\"}"
    done
fi

case $ev in
stop)
    line=$(python3 -I "$HERE/receipt.py" turn "$LOG" "$BELAY" "$SCOPE" "$D" 2>>"$D/$sid.err") \
        || fail "the turn's receipt failed (see $D/$sid.err)"
    say "$line" ;;
end)
    python3 -I "$HERE/receipt.py" session "$LOG" "$BELAY" "$SCOPE" "$D" \
        "${BELAY_DOGFOOD_NOTES:-$SCOPE/NOTES/dogfood}" 2>>"$D/$sid.err" >/dev/null \
        || fail "the session's receipt failed (see $D/$sid.err)" ;;
esac
exit 0
